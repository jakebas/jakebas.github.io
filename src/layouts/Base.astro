---
const { title = 'Jake Baskin', description = 'Jake Baskin on computer science education, teaching, and community.', active = '', article = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title === 'Jake Baskin' ? title : `${title} — Jake Baskin`}</title>
<meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title="Jake Baskin — Writing" href="/feed.xml" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="shell">
<header><a class="wordmark" href="/">Jake Baskin<span class="mark" aria-hidden="true">.</span></a><nav aria-label="Main navigation"><a href="/writing/" aria-current={active==='writing'?'page':undefined}>Writing</a><a href="/about/" aria-current={active==='about'?'page':undefined}>About</a></nav></header>
<main id="main" class:list={[{ article }]}><slot /></main>
<footer><span>Jake Baskin <span class="footer-dot">·</span> Chicago</span><div><a href="https://www.linkedin.com/in/jakebaskin/">LinkedIn <span aria-hidden="true">↗</span></a><a href="/feed.xml">RSS <span aria-hidden="true">↗</span></a></div></footer>
</div>
</body>
</html>
<style is:global>
:root{color-scheme:light;--paper:#f8f7f3;--ink:#272824;--muted:#6b6d65;--accent:#526347;--line:#dcded4;--serif:Georgia,'Times New Roman',serif;--sans:Arial,Helvetica,sans-serif}*{box-sizing:border-box}html{background:var(--paper);color:var(--ink);scroll-behavior:smooth}body{margin:0;font-family:var(--serif);font-size:20px;line-height:1.65;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration-color:#afb5a4;text-underline-offset:5px;text-decoration-thickness:1px}a:hover{color:var(--accent);text-decoration-color:var(--accent)}a:focus-visible{outline:2px solid var(--accent);outline-offset:6px}.shell{max-width:944px;padding:0 52px;margin:auto;min-height:100svh;display:flex;flex-direction:column}header{display:flex;justify-content:space-between;align-items:center;padding:43px 0 29px;border-bottom:1px solid var(--line);font-family:var(--sans)}.wordmark{font-size:20px;letter-spacing:-.6px;font-weight:600;text-decoration:none}.mark{color:var(--accent)}nav{display:flex;gap:29px;font-size:13px}nav a{text-decoration:none;color:var(--muted)}nav a[aria-current=page]{color:var(--ink);text-decoration:underline;text-underline-offset:7px}main{flex:1;padding:79px 0 86px}h1,h2,h3,p{margin-top:0}h1{font-weight:400;font-size:64px;line-height:1.12;letter-spacing:-2.5px;margin-bottom:30px}h2{font-size:32px;font-weight:400;line-height:1.25;letter-spacing:-.7px}p{margin-bottom:24px}.eyebrow,.section-label{font:11px/1.5 var(--sans);letter-spacing:1.8px;text-transform:uppercase;color:var(--muted)}.eyebrow{margin-bottom:24px}.lead{font-size:25px;line-height:1.55;letter-spacing:-.25px}.reading{max-width:650px}.muted{color:var(--muted)}.section{margin-top:66px;padding-top:26px;border-top:1px solid var(--line)}.section-top{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:25px}.section-label{margin:0}.small-link{font:12px/1.5 var(--sans)}.section p{font-size:19px}.text-link{font:13px/1.5 var(--sans)}footer{border-top:1px solid var(--line);padding:24px 0 34px;display:flex;justify-content:space-between;gap:15px;font:11px/1.6 var(--sans);color:var(--muted)}footer div{display:flex;gap:23px}footer a{text-decoration:none}.footer-dot{padding:0 7px}.post-row{border-bottom:1px solid var(--line);padding:24px 0}.post-row h2{margin:5px 0 10px}.post-row time,.article time{font:12px/1.5 var(--sans);color:var(--muted)}.post-row p{margin:0;color:var(--muted);font-size:18px}.post-row h2 a{text-decoration:none}.article{max-width:680px}.article h1{font-size:49px}.article h2{margin-top:40px}.article img{max-width:100%;height:auto}.article pre{overflow:auto;padding:20px;font-size:14px;background:#eeeee7}.article blockquote{border-left:2px solid var(--accent);margin-left:0;padding-left:24px;color:var(--muted)}.article ul,.article ol{padding-left:24px}.article-body{margin-top:42px}.skip{position:absolute;left:16px;top:-100px;background:var(--paper);padding:10px}.skip:focus{top:10px}.back{font:12px/1.5 var(--sans);display:inline-block;margin-bottom:35px}::selection{background:#dce2ce}@media(min-width:1400px){main{padding-top:100px}}@media(max-width:600px){.shell{padding:0 25px}header{padding-top:27px;padding-bottom:23px}.wordmark{font-size:18px}nav{gap:20px}main{padding:55px 0 64px}h1{font-size:46px;letter-spacing:-1.7px}.lead{font-size:22px}.section{margin-top:48px}.section-top{gap:12px}footer{font-size:10px}.article h1{font-size:39px}body{font-size:19px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
